# Public browser configuration. Use the URL and publishable key for your backend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server configuration. Usually the same backend as the browser configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only AI gateway key, required for built-in agents and LLM routing fallback.
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Optional: only needed when using Drizzle migration tooling.
# LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/database

# Server-only scheduled queue sweep authentication. Generate your own secret.
LOVABLE_CRON_SECRET=your-random-cron-secret
# LOVABLE_CRON_SECRET_PREVIOUS=your-previous-secret-during-rotation
